# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem
*.key
*.p12
*.pfx

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local credentials; keep the setup template trackable
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Local verification artifacts and transcode scratch files
/output/
/.playwright-cli/
/.auth/
/playwright/.auth/
/playwright-report/
/test-results/
/tmp/
*.log

# Local archives, design references and internal working notes
/.local/
/designs/
/docs/private/
/docs/AUDIT-*.md
/docs/BUDGET-*.md
/docs/REMEDIATION-*.md
/docs/REVISION-NOTES.md

# Local backups and diagnostic captures; keep Prisma SQL migrations tracked
/.backups/
/backups/
*.bak
*.dump
*.sql.gz
*.har
*.heapsnapshot
*.cpuprofile

# Personal editor and package-manager state
/.idea/
*.code-workspace
/.pnpm-store/
