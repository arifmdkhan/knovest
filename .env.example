# Copy to .env.local. Never commit real credentials.
# Neon: use the pooled connection URL with sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Optional Neon direct (non-pooler) URL for schema migrations.
DIRECT_URL=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_EMAIL=""
# Generate: pnpm exec node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""

# Google OAuth redirect: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

RESEND_API_KEY=""
# Use a sender on your verified Resend domain in production.
EMAIL_FROM="Knovest <noreply@YOUR_VERIFIED_DOMAIN>"

NEXT_PUBLIC_STREAM_API_KEY=""
STREAM_API_SECRET=""
# Keep false until provider authorization tests in the release runbook pass.
STREAM_PERMISSIONS_VERIFIED="false"
# Requires a persistent worker host with FFmpeg, disk and execution budget.
VIDEO_PROCESSING_ENABLED="false"
# Conservative daily reservation cap across all accounts (MiB); 0 blocks uploads.
# Per-account cap is 1024 MiB. Standard upload initiation AND confirmation reserve
# the intent maximum; failed attempts are not refunded.
UPLOAD_DAILY_MIB_LIMIT="10240"

# Neon Object Storage: use the exact branch endpoint and region from Neon.
AWS_REGION="ap-southeast-1"
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
NEXT_PUBLIC_S3_BUCKET_NAME_IMAGES="knovest-public"
NEXT_PRIVATE_S3_BUCKET_NAME_IMAGES="knovest-private"
# Optional override (for example, a CDN). Otherwise derived from endpoint + public bucket.
NEXT_PUBLIC_S3_PUBLIC_URL=""

# Generate a separate random secret; required by cleanup/transcode jobs.
CRON_SECRET=""
